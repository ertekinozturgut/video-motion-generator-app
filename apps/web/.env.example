# Bu dosyayı .env.local olarak kopyala ve doldur.
# Aynı beş değişken Vercel → Settings → Environment Variables altına da girilmeli.

# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable / anon key>

# DİKKAT: buraya yukarıdaki publishable anahtarı YAPIŞTIRMA.
# Supabase → Settings → API Keys → service_role / secret.
# sb_secret_... ya da eyJ... ile başlar; sb_publishable_ ile BAŞLAMAZ.
# RLS'i bypass eder. Asla NEXT_PUBLIC olmaz, asla tarayıcıya gönderilmez.
SUPABASE_SERVICE_ROLE_KEY=<service_role secret>

# Sağlayıcı API anahtarlarını çözen master anahtar: openssl rand -base64 32
# Bu kaybolursa kayıtlı tüm sağlayıcı anahtarları kalıcı olarak okunamaz olur.
PROVIDER_ENC_KEY_V1=<base64 32 bayt>
PROVIDER_ENC_KEY_CURRENT=1

# Cron ve iç dispatch çağrılarını korur: openssl rand -hex 32
CRON_SECRET=<hex 32 bayt>
